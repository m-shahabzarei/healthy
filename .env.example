# Vercel's Supabase integration for Healthy uses these names when connected
# with the HEALTHY prefix. The public pair is safe for the browser when Row
# Level Security is enabled by supabase/schema.sql.
NEXT_PUBLIC_HEALTHY_SUPABASE_URL=
NEXT_PUBLIC_HEALTHY_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_HEALTHY_SUPABASE_ANON_KEY=
HEALTHY_SUPABASE_URL=
HEALTHY_SUPABASE_SECRET_KEY=
HEALTHY_SUPABASE_SERVICE_ROLE_KEY=

# For a standalone Supabase project, the older unprefixed names also work.
NEXT_PUBLIC_SUPABASE_URL=

# A publishable key or legacy anon key is supported for standalone projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by /api/auth/register to create an already-confirmed
# internal username identity for standalone projects.
SUPABASE_SECRET_KEY=

# Never place SUPABASE_SECRET_KEY, service_role, database passwords, or other
# server secrets in a NEXT_PUBLIC_* variable or commit their values.
