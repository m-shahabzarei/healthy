# Public Supabase configuration. These values are safe for the browser when
# Row Level Security is enabled by supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=

# Vercel's current Supabase Marketplace integration uses a publishable key.
# A legacy anon key is also supported by the runtime for older projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by /api/auth/register to create an already-confirmed
# internal username identity. Vercel's Supabase integration injects this.
SUPABASE_SECRET_KEY=

# Never place SUPABASE_SECRET_KEY, service_role, database passwords, or other
# server secrets in a NEXT_PUBLIC_* variable or commit their values.
